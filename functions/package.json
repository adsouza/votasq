{
  "name": "votasq-functions",
  "private": true,
  "description": "Cloud Functions producers for the Votasq notification queue.",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "prebuild": "node tool/sync-arbs.mjs",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "sync:arbs": "node tool/sync-arbs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.2.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "firebase-functions-test": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
