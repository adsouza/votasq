rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /problems/{problemId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['description', 'votes', 'solved', 'version', 'geoscope'])
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 80
        && request.resource.data.geoscope is string
        && request.resource.data.geoscope.size() > 0
        && request.resource.data.geoscope.size() <= 72
        && request.resource.data.votes is int
        && request.resource.data.votes == 1
        && request.resource.data.solved is bool
        && request.resource.data.solved == false
        && request.resource.data.version is int
        && request.resource.data.version == 1;
      allow update: if
        // Vote-only update (auth required, votes +1, version unchanged)
        (
          request.auth != null
          && request.resource.data.votes == resource.data.votes + 1
          && request.resource.data.version == resource.data.version
        )
        ||
        // Complaint append (auth required, only complaints changes,
        // existing entries preserved, only the caller's own uid may be added)
        (
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complaints'])
          && request.resource.data.complaints is list
          && request.resource.data.complaints.hasAll(resource.data.get('complaints', []))
          && request.resource.data.complaints.hasOnly(resource.data.get('complaints', []).concat([request.auth.uid]))
          && request.auth.uid in request.resource.data.complaints
        )
        ||
        // Problem linking / clustering update (auth required, only
        // linkedProblemIds and/or typedLinks change, both size-limited to
        // prevent DoS). `typedLinks` carries directional specialization /
        // generalization tags; tagProblemLink and untagProblemLink in the
        // client may write either field individually or both together
        // (promoting a generic clique link into a typed pair severs the
        // generic edge and writes the typed entries in one batched update).
        (
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedProblemIds', 'typedLinks'])
          && request.resource.data.get('linkedProblemIds', []) is list
          && request.resource.data.get('linkedProblemIds', []).size() <= 100
          && request.resource.data.get('typedLinks', []) is list
          && request.resource.data.get('typedLinks', []).size() <= 100
        )
        ||
        // Hide / unhide. Only the owner may flip `hidden`, and only
        // `hidden` may change in the write. A description/goal edit
        // that also wants to change `hidden` must use two writes.
        (
          request.auth != null
          && request.auth.uid == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
          && request.resource.data.hidden is bool
        )
        ||
        // Full problem update
        (
          request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 80
          && request.resource.data.geoscope is string
          && request.resource.data.geoscope.size() > 0
          && request.resource.data.geoscope.size() <= 72
          && (request.resource.data.geoscope == resource.data.geoscope
              || (request.auth != null && request.auth.uid == resource.data.ownerId))
          && request.resource.data.votes is int
          && request.resource.data.votes >= 0
          && request.resource.data.solved is bool
          && request.resource.data.version is int
          && request.resource.data.version > resource.data.version
          && request.resource.data.hidden == resource.data.get('hidden', false)
        );

      match /versions/{versionId} {
        allow read: if true;
        allow create: if
          request.resource.data.keys().hasAll(['description', 'version', 'archivedAt'])
          && request.resource.data.description is string
          && request.resource.data.version is int
          && request.resource.data.archivedAt is timestamp
          // Optional: fork id stamped when the revision was sourced from a
          // fork via the "Use this here" flow on the detail page.
          && (
            !('copiedFromProblemId' in request.resource.data.keys())
            || request.resource.data.copiedFromProblemId is string
          );
      }

      match /voters/{voterId} {
        allow read: if true;
        allow create: if
          request.auth != null
          && request.auth.uid == voterId
          && request.resource.data.keys().hasAll(['uid', 'votes'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.votes is int
          && request.resource.data.votes == 1;
        allow update: if
          request.auth != null
          && request.auth.uid == voterId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.votes is int
          && request.resource.data.votes > resource.data.votes;
      }

      match /translations/{langCode} {
        allow read: if true;
        allow create: if
          request.resource.data.keys().hasAll(['description'])
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0;
        allow delete: if true;
      }
    }

    match /geoscopes/{geoscopeId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'votes', 'lastActiveAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.votes is int
        && request.resource.data.votes == 3 // Must match initialVoteBudget
        && request.resource.data.lastActiveAt is timestamp;
      allow update: if
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && (
          // Vote decrement
          (
            request.resource.data.votes is int
            && request.resource.data.votes == resource.data.votes - 1
            && request.resource.data.votes >= 0
          )
          ||
          // Vote grant on resume (time-based, with lastActiveAt update)
          (
            request.resource.data.votes is int
            && request.resource.data.lastActiveAt is timestamp
            && request.resource.data.votes > resource.data.votes
            && request.resource.data.votes - resource.data.votes < 10
          )
          ||
          // lastActiveAt touch (votes unchanged)
          (
            request.resource.data.votes == resource.data.votes
            && request.resource.data.lastActiveAt is timestamp
          )
          ||
          // Notification preferences and/or locale update (votes unchanged)
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['notificationPreferences', 'locale', 'lastActiveAt'])
            && request.resource.data.votes == resource.data.votes
          )
        );

      match /notifications/{notificationId} {
        // Recipient can read their own notifications and mark them read.
        // Cloud Functions (admin SDK) bypass these rules and own create/delete.
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt is timestamp;
        allow create, delete: if false;
      }

      match /fcmTokens/{tokenId} {
        // Device-level FCM registration owned by the user.
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['token', 'platform', 'createdAt', 'lastUsedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.lastUsedAt is timestamp;
        allow update: if
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastUsedAt'])
          && request.resource.data.lastUsedAt is timestamp;
      }
    }

    match /feedback/{feedbackId} {
      allow create: if
        request.auth != null
        && request.resource.data.keys().hasAll(['text', 'screenshotPath', 'userId', 'submittedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.screenshotPath is string
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
