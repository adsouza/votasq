#!/usr/bin/env bash
# Mirror CI's format + analyze checks before pushing, and guard against
# AGENTS.md / CLAUDE.md drifting beyond their tool-identity lines.
# Bypass (rarely): git push --no-verify
set -e

echo "[pre-push] dart format..."
melos format

echo "[pre-push] flutter analyze..."
flutter analyze apps packages

echo "[pre-push] cspell..."
npx --yes cspell --no-progress --no-summary --config .github/cspell.json "**/*.md"

echo "[pre-push] AGENTS.md / CLAUDE.md sync..."
if ! diff -q \
  <(sed -e '1s|^# AGENTS\.md$|# CLAUDE.md|' \
        -e '3s|Codex (Codex\.ai/code)|Claude Code (claude.ai/code)|' AGENTS.md) \
  .claude/CLAUDE.md > /dev/null; then
  echo "[pre-push] AGENTS.md and CLAUDE.md have drifted beyond their tool-identity lines:"
  diff AGENTS.md .claude/CLAUDE.md || true
  exit 1
fi

echo "[pre-push] ok"
