#!/usr/bin/env bash
# Mirror CI's format + analyze checks before pushing. Cheap/locally-actionable
# checks (cspell, AGENTS.md/CLAUDE.md sync) live in pre-commit so they surface
# at authoring time. Pre-push handles the slow CI-mirroring checks plus the
# web/index.html bootstrap-token guard.
# Bypass (rarely): git push --no-verify
set -e

echo "[pre-push] dart format..."
melos format

echo "[pre-push] flutter analyze..."
flutter analyze apps packages

echo "[pre-push] web/index.html flutter_bootstrap_js token..."
if ! grep -qF '{{flutter_bootstrap_js}}' apps/client/web/index.html; then
  echo "[pre-push] apps/client/web/index.html is missing the literal token {{flutter_bootstrap_js}}."
  echo "[pre-push] An HTML formatter probably added whitespace inside the braces — Flutter's build system"
  echo "[pre-push] only substitutes the exact unspaced token, so the web app fails to bootstrap."
  exit 1
fi

echo "[pre-push] ok"
